#version 460

layout(local_size_x = 8, local_size_y = 8) in;

layout(r8ui,set = 0, binding = 0) uniform uimage2D image0;
layout(rgba8ui,set = 0, binding = 1) uniform uimage2D image1;  //material, ?,?,?
layout(rgba16f,set = 0, binding = 2) uniform image2D image2;    //velocity x,velocity y, subpos x, subpos y

layout( push_constant ) uniform constants
{
    vec2 uv_min;
    vec2 uv_max;
    ivec2 batch_offset;
    uint frame_number;
} PushConstants;

struct MaterialProperties {
    float friction;
    float slidingFriction;
    float acceleration;
    float reserved;
};

layout(std140, set = 0, binding = 3) uniform MaterialBuffer {
    MaterialProperties materials[256];
} materialBuffer;

const int GRID_WIDTH = 512;
//const int GRID_HEIGHT = 512;
const int GRID_HEIGHT = 380;
const float STEPS = 20;
const float FIXED_STEP = 0.02;
const float DELTA_TIME = FIXED_STEP/STEPS;

void write1(ivec2 coord, uvec4 data);
void write2(ivec2 coord, vec4 data);
void clear(ivec2 coord);
void setDirty(ivec2 coord);
float random();
int randomSign();
bool handleMovement(
    bool isHorizontal,
    ivec2 originalCoords,
    inout ivec2 coords,
    inout float velocity,
    inout float otherAxisVelocity,
    inout float subPos,
    vec2 forcesTotal
);

void main()
{
    //COORDINATES
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy) * 3 + PushConstants.batch_offset;
    ivec2 originalCoords = coords;

    //PARAMETERS
    uvec4 properties1;
    vec4 properties2;
    uint flags;

    //EARLY RETURNS
    if (coords.x >= GRID_WIDTH || coords.y >= GRID_HEIGHT) return;
    flags = imageLoad(image0,coords).r;
    if (flags == 1) return; //isDirty flag
    properties1 = imageLoad(image1, coords);
    if (properties1.r == 0) return;
    properties2 = imageLoad(image2, coords);

    MaterialProperties material_properties = materialBuffer.materials[properties1.r];
    vec2 forces = vec2(0,200);
    bool yMoved = handleMovement(false,originalCoords,coords,properties2.g,properties2.r,properties2.a,forces);
    bool xMoved = handleMovement(true,originalCoords,coords,properties2.r,properties2.g,properties2.b,forces);

    if (yMoved || xMoved){
        clear(originalCoords);
        setDirty(coords);
        write1(coords,properties1);
        write2(coords,properties2);
    }else{
        write2(coords,properties2);
    }
}

bool handleMovement(
    bool isHorizontal,
    ivec2 originalCoords,
    inout ivec2 coords,
    inout float velocity,
    inout float otherAxisVelocity,
    inout float subPos,
    vec2 forcesTotal
) {
    float acceleration = isHorizontal ? forcesTotal.x : forcesTotal.y;
    velocity += DELTA_TIME * acceleration;
    subPos += velocity * DELTA_TIME;
    int movementDir = int(sign(velocity));
    if (movementDir == 0) return false;

    ivec2 axisVector = isHorizontal ? ivec2(1,0) : ivec2(0,1);
    float friction = 0.01;
    float slidingFriction = 0.7;

    ivec2 next_coords = coords + movementDir * axisVector;
    if (next_coords.y >= GRID_HEIGHT || next_coords.y <160 || next_coords.x >= GRID_WIDTH || next_coords.x <0) {   //temp
        otherAxisVelocity *= 1-friction;
    }else{
        uvec4 next_properties1 = imageLoad(image1, next_coords);
        if (next_properties1.r > 0) {
            otherAxisVelocity *= 1-friction;
        }
    }

    if (next_coords.y >= GRID_HEIGHT || next_coords.y <160 || next_coords.x >= GRID_WIDTH || next_coords.x <0){    //temp
        subPos = 0;
        velocity = 0;
    }else{
        uvec4 next_properties1 = imageLoad(image1, next_coords);
        vec4 next_properties2 = imageLoad(image2, next_coords);
        if (next_properties1.r > 0){
            MaterialProperties next_material_properties = materialBuffer.materials[next_properties1.r];
            float relativeVelocity = velocity - (isHorizontal ? next_properties2.r : next_properties2.g);
            float changeInVelocity = relativeVelocity/2;
            velocity -= changeInVelocity;
            if (isHorizontal){
                next_properties2.r += changeInVelocity;
            }else{
                next_properties2.g += changeInVelocity;
            }
            changeInVelocity = changeInVelocity < 0.2 ? 0 : changeInVelocity;
            float axisTransferAmount = (1-slidingFriction) * changeInVelocity;
            int directionSign = (otherAxisVelocity == 0 ? randomSign() : int(sign(otherAxisVelocity)));
            otherAxisVelocity += axisTransferAmount * directionSign;
            write2(next_coords,next_properties2);
        }else if (abs(subPos) >= 1){
            int movement = int(sign(subPos));
            coords += movement * axisVector;
            subPos -= movement;
            return true;
        }
    }
    return false;
}

void setDirty(ivec2 coord){
    imageStore(image0,coord,uvec4(1,0,0,0));
}

void write1(ivec2 coord,uvec4 data){
    imageStore(image1,coord,data);
}

void write2(ivec2 coord,vec4 data){
    imageStore(image2,coord,data);
}

void clear(ivec2 coord){
    write1(coord,uvec4(0,0,0,0));
    write2(coord,vec4(0.0,0.0,0.0,0.0));
}

float random() {
    vec2 pos = vec2(gl_GlobalInvocationID.xy);
    float seed = float(PushConstants.frame_number) * 0.1;
    vec2 seed_vec = vec2(seed,seed + 1.0) + pos;
    return fract(sin(dot(seed_vec, vec2(12.9898, 78.233))) * 43758.5453);
}

int randomSign() {
    float r = random();
    return r < 0.5 ? -1 : 1;
}

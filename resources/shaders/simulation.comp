//GLSL version to use
#version 460
//size of a workgroup for compute
layout (local_size_x = 16, local_size_y = 16) in;

//descriptor bindings for the pipeline
layout(rgba16f,set = 0, binding = 0) uniform image2D image;
//layout(rgba16f,set = 0, binding = 1) uniform image2D properties1;

layout(rgba16ui,set = 0, binding = 1) uniform uimage2D properties1_in;
layout(rgba16ui,set = 0, binding = 2) uniform uimage2D properties1_out;

layout(rgba16f,set = 0, binding = 3) uniform image2D properties2_in;
layout(rgba16f,set = 0, binding = 4) uniform image2D properties2_out;

layout( push_constant ) uniform constants
{
    bool swap_io;
} PushConstants;

void main()
{

    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);
    uvec4 properties1;
    vec4 properties2;
    if (PushConstants.swap_io) {
        properties1 = imageLoad(properties1_out, coords);
        properties2 = imageLoad(properties2_out, coords);
    } else {
        properties1 = imageLoad(properties1_in, coords);
        properties2 = imageLoad(properties2_in, coords);
    }


    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(image);

    if(texelCoord.x < size.x && texelCoord.y < size.y)
    {
        vec4 color = vec4(0.0, 0.0, 0.0, 1.0);

        if(gl_LocalInvocationID.x != 0 && gl_LocalInvocationID.y != 0)
        {
            color.x = float(texelCoord.x)/(size.x);
            color.y = float(texelCoord.y)/(size.y);
        }
        imageStore(properties2_in, texelCoord, color);
        imageStore(image, texelCoord, properties2);
    }
}

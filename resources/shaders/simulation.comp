#version 460

layout(local_size_x = 8, local_size_y = 8) in;

layout(r8ui,set = 0, binding = 0) uniform uimage2D image0;
layout(rgba8ui,set = 0, binding = 1) uniform uimage2D image1;  //material, ?,?,?
layout(rgba16f,set = 0, binding = 2) uniform image2D image2;    //velocity x,velocity y, subpos x, subpos y

layout( push_constant ) uniform constants
{
    vec2 uv_min;
    vec2 uv_max;
    ivec2 batch_offset;
    uint frame_number;
} PushConstants;

const int GRID_WIDTH = 512;
//const int GRID_HEIGHT = 512;
const int GRID_HEIGHT = 380;
const float STEPS = 20;
const float FIXED_STEP = 0.02;
const float DELTA_TIME = FIXED_STEP/STEPS;

void write1(ivec2 coord, uvec4 data);
void write2(ivec2 coord, vec4 data);
void clear(ivec2 coord);
void setDirty(ivec2 coord);
float random();
int randomSign();
bool handleMovement(
    ivec2 originalCoords,
    inout ivec2 coords,
    inout float velocity,
    inout float otherVelocity,
    inout float subPos,
    uint materialIndex,
    bool isHorizontal,
    float friction,
    float slidingFriction,
    float acceleration
);

void main()
{
    //PARAMETERS
    uvec4 properties1;
    vec4 properties2;
    uint flags;
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy) * 3 + PushConstants.batch_offset;
    ivec2 originalCoords = coords;
    //

    //EARLY RETURNS
    if (coords.x >= GRID_WIDTH || coords.y >= GRID_HEIGHT) return;
    flags = imageLoad(image0,coords).r;
    if (flags == 1) return;
    properties1 = imageLoad(image1, coords);
    if (properties1.r == 0) return;
    properties2 = imageLoad(image2, coords);
    //

    //MATERIAL PROPERTIES
    float friction = 0.001;
    float slidingFriction = 0.3;
    //

    bool yMoved = handleMovement(originalCoords,coords,properties2.g,properties2.r,properties2.a,properties1.r,false,friction,slidingFriction,200);
    bool xMoved = handleMovement(originalCoords,coords,properties2.r,properties2.g,properties2.b,properties1.r,true,friction,slidingFriction,0);
    
    if (yMoved || xMoved){
        clear(originalCoords);
        setDirty(coords);
        write1(coords,properties1);
        write2(coords,properties2);
    }else{
        write2(coords,properties2);
    }
}

bool handleMovement(
ivec2 originalCoords,
    inout ivec2 coords,
    inout float velocity,
    inout float otherVelocity,
    inout float subPos,
    uint materialIndex,
    bool isHorizontal,
    float friction,
    float slidingFriction,
    float acceleration
) {
    bool canApplyForce = false;
    ivec2 axisVector;
    if (isHorizontal){
        axisVector = ivec2(1,0);
    }else{
        axisVector = ivec2(0,1);
    }
    if (velocity != 0){
        int movement = int(sign(velocity));
        ivec2 next_coords = coords + movement * axisVector;
        if (next_coords.y >= GRID_HEIGHT || next_coords.y <160) {   //temp
            otherVelocity *= 1-friction;
        }else{
            uvec4 next_properties1 = imageLoad(image1, next_coords);
            if (next_properties1.r > 0) {
                otherVelocity *= 1-friction;
            }else{
                canApplyForce = true;
            }
        }
    }else{
        canApplyForce = true;
    }
    if (canApplyForce){
        velocity += DELTA_TIME * acceleration;
    }
    subPos += velocity * DELTA_TIME;

    int yMovement = 0;
    if (abs(subPos) >= 1){
        int movement = int(sign(subPos));
        ivec2 next_coords = coords + movement * axisVector;
        if (next_coords.y >= GRID_HEIGHT || next_coords.y <160){    //temp
            subPos = 0;
            velocity = 0;
        }else{
            uvec4 next_properties1 = imageLoad(image1, next_coords);
            vec4 next_properties2 = imageLoad(image2, next_coords);
            if (next_properties1.r > 0){
                subPos = yMovement;
                float relativeVelocity = velocity - next_properties2.g;
                float changeInVelocity = relativeVelocity/2;
                float axisTransferAmount = (1-slidingFriction) * changeInVelocity;
                int randomSign = randomSign();
                otherVelocity += axisTransferAmount * randomSign;
                velocity -= changeInVelocity;
                next_properties2.g += changeInVelocity;
                write2(next_coords,next_properties2);
            }else {
                coords += movement * axisVector;
                yMovement += movement;
                subPos -= movement;
            }
        }
    }
    return yMovement != 0;
}

void setDirty(ivec2 coord){
    imageStore(image0,coord,uvec4(1,0,0,0));
}

void write1(ivec2 coord,uvec4 data){
    imageStore(image1,coord,data);
}

void write2(ivec2 coord,vec4 data){
    imageStore(image2,coord,data);
}

void clear(ivec2 coord){
    write1(coord,uvec4(0,0,0,0));
    write2(coord,vec4(0.0,0.0,0.0,0.0));
}

float random() {
    vec2 pos = vec2(gl_GlobalInvocationID.xy);
    float seed = float(PushConstants.frame_number) * 0.1;
    vec2 seed_vec = vec2(seed,seed + 1.0) + pos;
    return fract(sin(dot(seed_vec, vec2(12.9898, 78.233))) * 43758.5453);
}

int randomSign() {
    float r = random();
    return r < 0.5 ? -1 : 1;
}
